# API（PHP）用：共通部分（_ で始まるファイル）は直接開けないようにする。応答はキャッシュしない
<FilesMatch "^_">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
</IfModule>
Options -Indexes
# メール送信（mb_send_mail）に PHP が付ける X-PHP-Originating-Script ヘッダーを止める（迷惑メール判定の減点要因。モジュール版 PHP 用）
<IfModule mod_php.c>
  php_flag mail.add_x_header Off
</IfModule>
